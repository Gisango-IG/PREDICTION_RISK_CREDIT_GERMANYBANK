table credit_scoring
	lineageTag: 52cdab89-32f5-47b2-a8c2-fe2e791d4e8d
	sourceLineageTag: [dbo].[credit_scoring]

	measure 'default rate' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('credit_scoring'),
			        FILTER('credit_scoring', 'credit_scoring'[credit_risk] = TRUE())
			    ),
			    COUNTROWS('credit_scoring')
			)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 36ea0c5d-b143-44d5-8eff-f165e124442b

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total number of credit' = COUNTROWS('credit_scoring')
		formatString: 0
		lineageTag: 7edb2547-b994-4b2d-856c-efdbdec71da5

		changedProperty = Name

	measure 'Total amount credit' = SUM('credit_scoring'[amount])
		formatString: 0
		lineageTag: 96bbcce8-98ad-47aa-a07d-23ab0fdc0414

		changedProperty = Name

	measure 'Avarage of amount credit' = AVERAGE('credit_scoring'[amount])
		lineageTag: 6e5c8bc9-70ca-4575-8211-b0685cc813c3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pct Credit Risk' = ```
			
			DIVIDE(
			    [Total number of credit],
			    CALCULATE(
			        [Total number of credit],
			        ALL('credit_scoring')
			    )
			)
			
			```
		lineageTag: c97d535b-564a-4783-afd2-123ec1b81b2f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Exposure at Risk' = ```
			
			CALCULATE(
			    SUM('credit_scoring'[amount]),
			    'credit_scoring'[credit_risk] = TRUE()
			)
			
			```
		formatString: 0.0
		lineageTag: 12ea30d4-64bf-4c33-b1d0-51453935593d

		changedProperty = Name

		changedProperty = FormatString

	measure 'Risk Density' = ```
			
			DIVIDE(
			    [Exposure at Risk],
			    [Total amount credit]
			)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7a212f48-8dcc-4c55-8218-4a04e0e7a5d7

		changedProperty = Name

		changedProperty = FormatString

	measure 'Nb True' = ```
			
			CALCULATE(
			    COUNTROWS('credit_scoring'),
			    'credit_scoring'[credit_risk] = TRUE()
			)
			
			
			```
		formatString: 0
		lineageTag: 1a026c44-37b0-4c6f-b3df-b8e9e3ce277d

		changedProperty = Name

	measure 'Nb False' = ```
			
			CALCULATE(
			    COUNTROWS('credit_scoring'),
			    'credit_scoring'[credit_risk] = FALSE()
			)
			
			```
		formatString: 0
		lineageTag: b41d6ea5-3c12-44a9-8af5-28c8bfb2401c

		changedProperty = Name

	measure TrueGreaterThanFalse = ```
			
			IF([Nb True] > [Nb False], 1, 0)
			
			```
		formatString: 0
		lineageTag: 722074d4-fbac-478b-88d3-8ad779c0f950

		changedProperty = Name

