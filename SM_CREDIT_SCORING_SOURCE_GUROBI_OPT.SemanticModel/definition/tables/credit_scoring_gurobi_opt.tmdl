			FORMAT ( [Value per Risk Unit – Baseline], "0.00" )
		lineageTag: aa019f9e-73b9-4e6f-92d2-105673bfb880

		changedProperty = Name

	measure 'Expected Loss – Optimized (K)' =
			
			DIVIDE ( [Expected Loss – Optimized], 1000 )
		lineageTag: 785a7c36-eb7e-4d22-8c5f-a1b63fb3623c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expected Loss – Baseline (K)' =
			
			DIVIDE ( [Expected Loss – Baseline], 1000 )
		lineageTag: e53a6ed4-3c0e-4e45-9874-f4432b11c7d5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Card Title – Exposure at Risk' =
			
			"Optimized: " &
			FORMAT ( [Exposure at Risk – Optimized] / 1000, "0" ) & "K" &
			"  |  Baseline: " &
			FORMAT ( [Exposure at Risk – Baseline] / 1000000, "0.00" ) & "M"
		lineageTag: 3a4e9166-915c-4a3b-b221-f25f6726b82e

		changedProperty = Name

	measure 'Expected Loss – Removed Credits' =
			
			CALCULATE (
			    SUM ( credit_scoring_gurobi_opt[expected_loss] ),
			    credit_scoring_gurobi_opt[optim_choice] = FALSE
			)
		lineageTag: d06731bc-be44-4077-a635-714b23089502

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expected Loss – Kept Credits' = ```
			
			CALCULATE (
			    SUM ( credit_scoring_gurobi_opt[expected_loss] ),
			    credit_scoring_gurobi_opt[optim_choice] = TRUE
			)
			
			```
		lineageTag: 5021c2c6-a23d-4a2d-a7f8-863c2fbd1321

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Waterfall – Expected Loss' = ```
			
			VAR Baseline = [Expected Loss – Baseline]
			VAR Removed  = [Expected Loss – Removed Credits]
			VAR Optim    = [Expected Loss – Optimized]
			VAR Kept     = [Expected Loss – Kept Credits]
			
			RETURN
			SWITCH(
			    SELECTEDVALUE('Waterfall Steps'[Step]),
			    "Baseline", Baseline,
			    "Removed Credits", -Removed,
			    "Exposure Reduction", -(Kept - Optim),
			    "Optimized", Optim
			)
			
			```
		lineageTag: 86ffb61d-5950-4fd5-a888-fcf889c4d827

		changedProperty = Name

	measure 'Portfolio Type' = ```
			
			IF (
			    credit_scoring_gurobi_opt[optim_choice] = 1,
			    "Optimized",
			    "Baseline"
			)
			
			```
		lineageTag: 3bd0e6d9-4498-40ce-95f8-fbcc97ce7076

		changedProperty = Name

	measure 'Test Optim' =
			
			MAX( credit_scoring_gurobi_opt[optim_choice] )
		formatString: 0
		lineageTag: ff2b59f1-c665-4e56-add0-cb6e634d56f2

		changedProperty = Name

	measure 'Avg EV – Baseline' =
			
			AVERAGE ( credit_scoring_gurobi_opt[expected_value] )
		lineageTag: bac8ccd5-54ea-4461-a243-ec74a87fcaa4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg EV – Optimized' =
			
			CALCULATE (
			    AVERAGE ( credit_scoring_gurobi_opt[expected_value] ),
			    credit_scoring_gurobi_opt[portfolio_type] = "Optimized"
			)
		lineageTag: a029c70f-291f-47c4-8824-1a153799518f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Card Title – Avg Expected Value' =
			
			"Optimized: " &
			FORMAT ( [Avg EV – Optimized], "0.00" ) &
			"  |  Baseline: " &
			FORMAT ( [Avg EV – Baseline], "0.00" )
		lineageTag: c9405515-7d2c-4899-8627-8569523895cc

		changedProperty = Name

